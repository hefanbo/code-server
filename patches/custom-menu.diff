+	private addCustomMenus(customMenus: ReadonlyArray<ICustomMenu>): void {
+		const menuIds = new Map<ICustomMenu['menu'], MenuId>([
+			['file', MenuId.MenubarFileMenu],
+			['go', MenuId.MenubarGoMenu],
+			['help', MenuId.MenubarHelpMenu],
+		]);
+
+		let commandIndex = 0;
+		let topGroupIndex = 0;
+		let bottomGroupIndex = 0;
+
+		// Top groups use the '0_' range: menu groups sort by localeCompare of
+		// their group name, and digits sort before letters, so '0_custom_*'
+		// lands before all native '1_*'..'9_*' groups. The literal
+		// 'navigation' group is special-cased first in menuService, but a
+		// 'navigation_*' prefix does NOT inherit that ordering and would sort
+		// after all native groups. Bottom groups use the 'z_' range (sorted
+		// after '9_*'). A distinct group per group block produces the
+		// separator between blocks and preserves the entry order within each
+		// block.
+		const groupName = (position: 'top' | 'bottom'): string => {
+			return position === 'top' ? `0_custom_${topGroupIndex++}` : `z_custom_${bottomGroupIndex++}`;
+		};
+
+		for (const customMenu of customMenus) {
+			const menuId = menuIds.get(customMenu.menu);
+			if (!menuId) {
+				continue; // validated on the server
+			}
+
+			for (const group of customMenu.groups) {
+				const currentGroup = groupName(group.position);
+				let orderIndex = 0;
+				for (const entry of group.entries) {
+					this.addCustomMenuCommand(CodeServerClient.CUSTOM_MENU_COMMAND_ID_PREFIX + commandIndex++, entry, menuId, currentGroup, orderIndex++);
+				}
+			}
+		}
+	}
+
+	private addCustomMenuCommand(cmdId: string, entry: ICustomMenuEntry, menuId: MenuId, group: string, order: number): void {
+		const title = this.resolveCustomMenuName(entry.names);
+		if (!title) {
+			return;
+		}
+
+		const link = entry.link;
+		CommandsRegistry.registerCommand(cmdId, () => {
+			const customUrl = new URL(link, window.location.href);
+			window.location.assign(customUrl);
+		});
+
+		MenuRegistry.appendMenuItem(menuId, {
+			group,
+			order,
+			command: {
+				id: cmdId,
+				title,
+			},
+		});
+	}
+
+	/**
+	 * Resolve the localized label for the current UI language. Falls back in
+	 * the order: exact locale (zh-cn) -> language (zh) -> any locale ('*') ->
+	 * en -> first declared key.
+	 */
+	private resolveCustomMenuName(names: Record<string, string>): string | undefined {
+		const locale = language.toLowerCase();
+
+		const exact = names[locale];
+		if (exact) {
+			return exact;
+		}
+
+		const languagePrefix = locale.split('-')[0];
+		if (languagePrefix !== locale) {
+			const prefix = names[languagePrefix];
+			if (prefix) {
+				return prefix;
+			}
+		}
+
+		const anyLocale = names['*'];
+		if (anyLocale) {
+			return anyLocale;
+		}
+
+		const english = names['en'];
+		if (english) {
+			return english;
+		}
+
+		return Object.values(names)[0];
+	}
