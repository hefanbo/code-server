+	private async loadCustomMenus(): Promise<ReadonlyArray<ICustomMenu> | undefined> {
+		const customMenusFile = this._environmentService.args['custom-menu-file'];
+		if (!customMenusFile) {
+			return undefined;
+		}
+
+		let content: string;
+		try {
+			content = (await promises.readFile(customMenusFile)).toString();
+		} catch (error) {
+			this._logService.error(`[custom menus] Unable to read custom menus file '${customMenusFile}': ${error}`);
+			return undefined;
+		}
+
+		let parsed: unknown;
+		try {
+			parsed = loadYaml(content);
+		} catch (error) {
+			this._logService.error(`[custom menus] Unable to parse YAML from '${customMenusFile}': ${error}`);
+			return undefined;
+		}
+
+		if (typeof parsed !== 'object' || parsed === null) {
+			this._logService.error(`[custom menus] '${customMenusFile}' must contain a 'custom-menus' list`);
+			return undefined;
+		}
+
+		const rawMenus = (parsed as Record<string, unknown>)['custom-menus'];
+		if (!Array.isArray(rawMenus)) {
+			this._logService.error(`[custom menus] '${customMenusFile}' must contain a 'custom-menus' list`);
+			return undefined;
+		}
+
+		const menus: ICustomMenu[] = [];
+		for (const rawMenu of rawMenus) {
+			const menu = this.parseCustomMenu(rawMenu);
+			if (menu) {
+				menus.push(menu);
+			}
+		}
+
+		if (menus.length === 0) {
+			this._logService.warn(`[custom menus] No valid menu entries found in '${customMenusFile}'`);
+		} else {
+			this._logService.info(`[custom menus] Loaded ${menus.map(menu => menu.menu).join(', ')} menus from '${customMenusFile}'`);
+		}
