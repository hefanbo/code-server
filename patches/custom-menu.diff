+		const menu = (raw as Record<string, unknown>)['menu'];
+		if (menu !== 'file' && menu !== 'go' && menu !== 'help') {
+			this._logService.warn(`[custom menus] Unknown menu '${String(menu)}', expected file, go or help. Skipping entry`);
+			return undefined;
+		}
+
+		const rawGroups = (raw as Record<string, unknown>)['groups'];
+		if (!Array.isArray(rawGroups)) {
