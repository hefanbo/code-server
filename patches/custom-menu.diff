+	/**
+	 * A plain string applies to any locale; a map is keyed by locale.
+	 */
+	private parseCustomMenuNames(raw: unknown): Record<string, string> | undefined {
+		if (typeof raw === 'string' && raw !== '') {
+			return { '*': raw };
