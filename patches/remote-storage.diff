+	get path(): string | undefined {
+		if (!this.options.useInMemoryStorage) {
+			return join(this.profile.globalStorageHome.with({ scheme: Schemas.file }).fsPath, BaseProfileAwareStorageMain.STORAGE_NAME);
+		}
